---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCollection } from 'astro:content';

const faqs = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(faqs.map((entry) => entry.render()));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((entry) => ({
    '@type': 'Question',
    name: entry.data.question,
  })),
};
---

<BaseLayout
  title="Frequently Asked Questions"
  description="Answers to common questions about incorporating, doing business, and working with Fortis Corporate Services in Sri Lanka."
  path="/faq"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="bg-navy">
    <div class="container-px mx-auto max-w-content py-20 sm:py-28">
      <p class="eyebrow">FAQ</p>
      <h1 class="mt-3 text-4xl sm:text-5xl text-white max-w-2xl">Frequently Asked Questions</h1>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-px mx-auto max-w-content max-w-3xl">
      <div class="divide-y divide-navy-100">
        {faqs.map((entry, i) => {
          const { Content } = rendered[i];
          return (
            <details class="group py-6 reveal" data-reveal-delay={(i % 5) * 60} name="faq">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
                <span class="text-lg text-navy font-medium">{entry.data.question}</span>
                <span class="shrink-0 text-bronze text-2xl leading-none group-open:rotate-45 transition-transform">+</span>
              </summary>
              <div class="mt-4 text-charcoal/80 leading-relaxed prose-p:my-2">
                <Content />
              </div>
            </details>
          );
        })}
      </div>
    </div>
  </section>

  <CtaBand heading="Didn't find what you were looking for?" body="Send us your question and we'll get back to you directly." />
</BaseLayout>
