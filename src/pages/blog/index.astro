---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title="Blog"
  description="Insights and updates from Fortis Corporate Services on corporate, legal, HR, accounting and compliance matters in Sri Lanka."
  path="/blog"
>
  <section class="bg-navy">
    <div class="container-px mx-auto max-w-content py-20 sm:py-28">
      <p class="eyebrow">Insights</p>
      <h1 class="mt-3 text-4xl sm:text-5xl text-white max-w-2xl">Blog</h1>
      <p class="mt-6 max-w-2xl text-navy-100">
        Practical updates and commentary on corporate, legal, HR, accounting and compliance matters in Sri Lanka.
      </p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-px mx-auto max-w-content">
      {posts.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post, i) => (
            <a
              href={`/blog/${post.slug}`}
              class="group block rounded-sm border border-navy-100 bg-white p-7 hover:border-bronze hover:shadow-md transition-all duration-150 reveal"
              data-reveal-delay={(i % 3) * 90}
            >
              <h2 class="text-xl leading-snug group-hover:text-bronze-600">{post.data.title}</h2>
              <p class="mt-3 text-sm text-charcoal/80">{post.data.description}</p>
              <span class="mt-4 inline-block text-sm font-semibold text-bronze">Read more →</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-xl text-navy">We're just getting started.</p>
          <p class="mt-3 text-charcoal/70 max-w-lg mx-auto">
            Our blog is on its way — check back soon for insights on corporate, legal, HR, accounting and compliance matters in Sri Lanka.
          </p>
        </div>
      )}
    </div>
  </section>

  <CtaBand heading="Have a question in the meantime?" body="Get in touch and we'll be glad to help directly." />
</BaseLayout>
