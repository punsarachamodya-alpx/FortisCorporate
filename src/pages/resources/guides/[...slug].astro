---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await guide.render();
---

<BaseLayout title={guide.data.title} description={guide.data.description} path={`/resources/guides/${guide.slug}`}>
  <section class="bg-navy">
    <div class="container-px mx-auto max-w-content py-20 sm:py-28">
      <p class="eyebrow">Guide</p>
      <h1 class="mt-3 text-4xl sm:text-5xl text-white max-w-2xl">{guide.data.title}</h1>
      <p class="mt-6 max-w-2xl text-navy-100">{guide.data.description}</p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-px mx-auto max-w-content max-w-3xl prose prose-neutral prose-headings:font-heading prose-headings:text-navy prose-a:text-bronze-600">
      <Content />
    </div>
  </section>

  <CtaBand heading="Have a question about this?" body="Get in touch and we'll be glad to help." />
</BaseLayout>
