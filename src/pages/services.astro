---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const svc = (await getCollection('servicesContent'))[0].data;
---

<BaseLayout
  title="Services"
  description="Corporate & company secretarial, commercial contracts, HR & employment, notarial & statutory documentation, accounting & tax, and legal advisory services in Sri Lanka."
  path="/services"
>
  <section class="bg-navy">
    <div class="container-px mx-auto max-w-content py-20 sm:py-28">
      <p class="eyebrow">{svc.heroEyebrow}</p>
      <h1 class="mt-3 text-4xl sm:text-5xl text-white max-w-2xl">{svc.heroHeading}</h1>
      <p class="mt-6 max-w-2xl text-navy-100">
        {svc.heroSubheading}
      </p>
    </div>
  </section>

  <!-- Jump nav -->
  <nav aria-label="Service categories" class="sticky top-20 z-40 bg-white border-b border-navy-100">
    <ul class="container-px flex justify-start gap-6 lg:gap-10 overflow-x-auto py-4 text-sm font-medium whitespace-nowrap">
      {services.map((service) => (
        <li>
          <a href={`#${service.data.anchor}`} class="text-navy hover:text-bronze">{service.data.title}</a>
        </li>
      ))}
    </ul>
  </nav>

  {services.map((service, index) => (
    <section id={service.data.anchor} class:list={['section scroll-mt-36', index % 2 === 0 ? 'bg-offwhite' : 'bg-white']}>
      <div class="container-px mx-auto max-w-content">
        <p class="eyebrow">{`0${index + 1}`}</p>
        <h2 class="mt-3 text-3xl sm:text-4xl max-w-2xl">{service.data.title}</h2>
        <p class="mt-4 max-w-2xl text-charcoal/80">{service.data.summary}</p>

        <div class="mt-10 grid md:grid-cols-2 gap-6">
          {service.data.subservices.map((sub, i) => (
            <div class="service-card reveal rounded-sm border border-navy-100 bg-white p-6" data-reveal-delay={(i % 2) * 100}>
              <h3 class="text-lg">{sub.name}</h3>
              <p class="service-desc hidden mt-2 text-sm text-charcoal/80">{sub.description}</p>
              <button type="button" class="read-more-toggle mt-3 inline-flex items-center gap-1 text-sm font-semibold text-bronze hover:text-bronze-600" aria-expanded="false">
                <span class="read-more-label">Read more</span>
                <svg class="read-more-icon w-3.5 h-3.5 transition-transform duration-200" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 7.5L10 12.5L15 7.5" />
                </svg>
              </button>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <CtaBand heading={svc.ctaHeading} body={svc.ctaBody} />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('.service-card').forEach((card) => {
    const desc = card.querySelector<HTMLElement>('.service-desc');
    const toggle = card.querySelector<HTMLButtonElement>('.read-more-toggle');
    const label = card.querySelector<HTMLElement>('.read-more-label');
    const icon = card.querySelector<SVGElement>('.read-more-icon');
    if (!desc || !toggle || !label) return;

    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      desc.classList.toggle('hidden', isExpanded);
      label.textContent = isExpanded ? 'Read more' : 'Read less';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      icon?.classList.toggle('rotate-180', !isExpanded);
    });
  });
</script>
