---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCollection } from 'astro:content';

const about = (await getCollection('aboutContent'))[0].data;
---

<BaseLayout
  title="About Us"
  description="Fortis Corporate Services (Pvt) Ltd is a professional firm providing corporate, legal, HR, accounting, branding, marketing and related business services to clients in Sri Lanka and overseas."
  path="/about"
>
  <section class="bg-navy">
    <div class="container-px mx-auto max-w-content py-20 sm:py-28">
      <p class="eyebrow">{about.heroEyebrow}</p>
      <h1 class="mt-3 text-4xl sm:text-5xl text-white max-w-2xl">{about.heroHeading}</h1>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-px mx-auto max-w-content max-w-3xl">
      {about.paragraphs.map((paragraph, i) => (
        <p class:list={['leading-relaxed text-charcoal/90 reveal', i === 0 ? 'text-lg' : 'mt-6']} set:html={paragraph} />
      ))}
    </div>
  </section>

  <section class="section bg-offwhite">
    <div class="container-px mx-auto max-w-content">
      <p class="eyebrow">{about.teamEyebrow}</p>
      <h2 class="mt-3 text-3xl sm:text-4xl max-w-2xl">{about.teamHeading}</h2>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12">
        {about.team.map((member, i) => (
          <div class="text-center reveal" data-reveal-delay={(i % 4) * 90}>
            <img
              src={member.photo}
              alt={member.name}
              width="200"
              height="200"
              loading="lazy"
              class="mx-auto h-32 w-32 sm:h-36 sm:w-36 rounded-full object-cover border border-navy-100"
            />
            <p class="mt-4 text-base font-semibold text-navy">{member.name}</p>
            <p class="mt-1 text-sm text-charcoal/70">{member.title}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-px mx-auto max-w-content">
      <p class="eyebrow">{about.statsEyebrow}</p>
      <h2 class="mt-3 text-3xl sm:text-4xl max-w-2xl">{about.statsHeading}</h2>
      <div class="mt-12 grid sm:grid-cols-3 gap-8">
        {about.stats.map((stat, i) => (
          <div class="rounded-sm bg-white border border-navy-100 p-7 reveal" data-reveal-delay={i * 90}>
            <p class="font-heading text-3xl text-bronze">{stat.value}</p>
            <p class="mt-2 text-sm text-charcoal/80">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand heading={about.ctaHeading} body={about.ctaBody} />
</BaseLayout>
