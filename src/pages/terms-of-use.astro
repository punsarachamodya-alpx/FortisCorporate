---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('legalPages', 'terms-of-use');
const { Content } = await entry.render();
---

<BaseLayout
  title="Terms of Use"
  description="Terms governing use of the Fortis Corporate Services website."
  path="/terms-of-use"
>
  <section class="bg-navy">
    <div class="container-px mx-auto max-w-content py-16 sm:py-20">
      <h1 class="text-4xl text-white">{entry.data.title}</h1>
      <p class="mt-3 text-navy-100">Last updated: {entry.data.lastUpdated}</p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-px mx-auto max-w-content max-w-3xl prose prose-neutral prose-headings:font-heading prose-headings:text-navy prose-a:text-bronze-600">
      <Content />
    </div>
  </section>
</BaseLayout>
