---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FIRM, links, serviceCategorySlugs } from '../lib/site';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Fortis Corporate Services — submit an enquiry or message us directly on WhatsApp."
  path="/contact"
>
  <section class="bg-navy">
    <div class="container-px mx-auto max-w-content py-20 sm:py-28">
      <p class="eyebrow">Get in touch</p>
      <h1 class="mt-3 text-4xl sm:text-5xl text-white max-w-2xl">Let's talk about your requirements</h1>
      <p class="mt-6 max-w-2xl text-navy-100">
        Submit an enquiry below, or message us directly on WhatsApp.
      </p>

      <!-- Prominent click-to-WhatsApp, especially useful on mobile -->
      <a href={links.whatsapp} target="_blank" rel="noopener" class="mt-8 inline-flex btn-primary">
        Message on WhatsApp
      </a>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-px mx-auto max-w-content grid lg:grid-cols-5 gap-14">
      <!-- Enquiry form -->
      <div class="lg:col-span-3 reveal">
        <h2 class="text-2xl sm:text-3xl">Submit an Enquiry</h2>
        <p class="mt-3 text-charcoal/80">
          Fill in the form and we'll get back to you as soon as possible. Fields marked * are required.
        </p>

        <form id="enquiry-form" class="mt-8 grid sm:grid-cols-2 gap-5" novalidate>
          <input type="hidden" name="form_type" value="enquiry" />
          <!-- honeypot -->
          <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />

          <div class="sm:col-span-1">
            <label for="name" class="block text-sm font-medium text-navy">Name *</label>
            <input id="name" name="name" type="text" required class="mt-1.5 w-full rounded-sm border border-navy-100 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-bronze" />
          </div>

          <div class="sm:col-span-1">
            <label for="email" class="block text-sm font-medium text-navy">Email *</label>
            <input id="email" name="email" type="email" required class="mt-1.5 w-full rounded-sm border border-navy-100 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-bronze" />
          </div>

          <div class="sm:col-span-1">
            <label for="phone" class="block text-sm font-medium text-navy">Phone *</label>
            <input id="phone" name="phone" type="tel" required class="mt-1.5 w-full rounded-sm border border-navy-100 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-bronze" />
          </div>

          <div class="sm:col-span-1">
            <label for="company" class="block text-sm font-medium text-navy">Company (optional)</label>
            <input id="company" name="company" type="text" class="mt-1.5 w-full rounded-sm border border-navy-100 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-bronze" />
          </div>

          <div class="sm:col-span-2">
            <label for="service" class="block text-sm font-medium text-navy">Service of interest</label>
            <select id="service" name="service" class="mt-1.5 w-full rounded-sm border border-navy-100 px-4 py-3 bg-white focus:outline-none focus:ring-2 focus:ring-bronze">
              <option value="">Select a service (optional)</option>
              {serviceCategorySlugs.map((s) => (
                <option value={s.label}>{s.label}</option>
              ))}
              <option value="Other / not sure">Other / not sure</option>
            </select>
          </div>

          <div class="sm:col-span-2">
            <label for="message" class="block text-sm font-medium text-navy">Message *</label>
            <textarea id="message" name="message" rows="5" required class="mt-1.5 w-full rounded-sm border border-navy-100 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-bronze"></textarea>
          </div>

          <div class="sm:col-span-2">
            <button type="submit" class="btn-primary">Submit Enquiry</button>
            <p id="enquiry-status" class="mt-3 text-sm" role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>

      <!-- Contact details -->
      <div class="lg:col-span-2 space-y-8 reveal" data-reveal-delay="120">
        <div class="rounded-sm border border-navy-100 p-7">
          <h3 class="text-lg text-navy">Office</h3>
          <p class="mt-2 text-sm text-charcoal/80">{FIRM.address.full}</p>

          <h3 class="mt-6 text-lg text-navy">Office Hours</h3>
          <p class="mt-2 text-sm text-charcoal/80">{FIRM.officeHours}</p>

          <h3 class="mt-6 text-lg text-navy">Phone &amp; WhatsApp</h3>
          <p class="mt-2 text-sm text-charcoal/80">
            {FIRM.phoneDisplay}
            {' '}·{' '}
            <a href={links.whatsapp} target="_blank" rel="noopener" class="text-bronze-600 hover:underline">Message on WhatsApp</a>
          </p>

          <h3 class="mt-6 text-lg text-navy">Email</h3>
          <p class="mt-2 text-sm text-charcoal/80">
            <a href={links.email} class="text-bronze-600 hover:underline">{FIRM.email}</a>
          </p>
        </div>

        <div class="rounded-sm overflow-hidden border border-navy-100">
          <iframe
            title={`Map showing ${FIRM.address.full}`}
            src={links.googleMapsEmbed}
            width="100%"
            height="280"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('enquiry-form') as HTMLFormElement | null;
  const status = document.getElementById('enquiry-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;

    const formData = new FormData(form);
    if ((formData.get('website') as string)?.length) return; // honeypot tripped

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    status.textContent = 'Sending…';
    status.className = 'mt-3 text-sm text-charcoal/70';

    try {
      const res = await fetch('/server/send.php', {
        method: 'POST',
        body: formData,
      });
      const result = await res.json();

      if (result.success) {
        status.textContent = "Thank you — your enquiry has been sent. We'll be in touch shortly.";
        status.className = 'mt-3 text-sm text-green-700';
        form.reset();
      } else {
        status.textContent = result.message || 'Something went wrong. Please try again or email us directly.';
        status.className = 'mt-3 text-sm text-red-700';
        submitBtn.disabled = false;
      }
    } catch {
      status.textContent = 'Something went wrong. Please try again, or email us directly.';
      status.className = 'mt-3 text-sm text-red-700';
      submitBtn.disabled = false;
    }
  });
</script>
