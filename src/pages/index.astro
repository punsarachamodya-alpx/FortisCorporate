---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatCounter from '../components/StatCounter.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const home = (await getCollection('homeContent'))[0].data;
---

<BaseLayout
  title="Fortis Corporate Services — Corporate, Legal & Compliance Support in Sri Lanka"
  description="Fortis Corporate Services provides corporate, legal, HR, accounting, compliance, branding and marketing support to businesses and investors in Sri Lanka — under one roof."
  path="/"
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy">
    <div class="absolute inset-0 opacity-[0.07]" aria-hidden="true">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="48" height="48" patternUnits="userSpaceOnUse">
            <path d="M 48 0 L 0 0 0 48" fill="none" stroke="#F7F7F8" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
      </svg>
    </div>
    <div class="relative container-px mx-auto max-w-content py-24 sm:py-32 lg:py-40">
      {home.heroEyebrow && <p class="eyebrow">{home.heroEyebrow}</p>}
      <h1 class="mt-4 max-w-3xl text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.1]">
        {home.heroHeadline}
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-bronze">
        {home.heroSubheadline}
      </p>
    </div>
  </section>

  <!-- Stats band -->
  <section class="bg-navy-700">
    <div class="container-px mx-auto max-w-content py-14 grid grid-cols-1 sm:grid-cols-3 gap-10">
      {home.stats.map((stat) => (
        <StatCounter value={stat.value} suffix={stat.suffix} label={stat.label} />
      ))}
    </div>
  </section>

  <!-- Service teaser -->
  <section class="section bg-offwhite">
    <div class="container-px mx-auto max-w-content">
      <p class="eyebrow reveal">{home.servicesEyebrow}</p>
      <h2 class="mt-3 text-3xl sm:text-4xl max-w-2xl reveal">{home.servicesHeading}</h2>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map((service, i) => (
          <a
            href={`/services#${service.data.anchor}`}
            class="group block rounded-sm border border-navy-100 bg-white p-7 hover:border-bronze hover:shadow-md transition-all duration-150 reveal"
            data-reveal-delay={(i % 4) * 90}
          >
            <h3 class="text-xl leading-snug group-hover:text-bronze-600">{service.data.shortTitle}</h3>
            <p class="mt-3 text-sm text-charcoal/80">{service.data.homeSummary ?? service.data.summary}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-bronze">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Fortis -->
  <section class="section bg-white">
    <div class="container-px mx-auto max-w-content">
      <p class="eyebrow reveal">{home.whyFortisEyebrow}</p>
      <h2 class="mt-3 text-3xl sm:text-4xl max-w-2xl reveal">{home.whyFortisHeading}</h2>
      <div class="mt-12 grid md:grid-cols-3 gap-10">
        {home.whyFortis.map((item, i) => (
          <div class="reveal" data-reveal-delay={i * 100}>
            <div class="h-1 w-10 bg-bronze mb-5"></div>
            <h3 class="text-xl">{item.title}</h3>
            <p class="mt-3 text-sm text-charcoal/80">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who we serve -->
  <section class="section bg-offwhite">
    <div class="container-px mx-auto max-w-content">
      <p class="eyebrow reveal">{home.whoWeServeEyebrow}</p>
      <h2 class="mt-3 text-3xl sm:text-4xl max-w-2xl reveal">{home.whoWeServeHeading}</h2>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-8">
        {home.whoWeServe.map((item, i) => (
          <div class="border-l-2 border-bronze pl-5 reveal" data-reveal-delay={(i % 3) * 80}>
            <h3 class="text-base font-semibold text-navy">{item.group}</h3>
            <p class="mt-1 text-sm text-charcoal/80">{item.line}</p>
          </div>
        ))}
      </div>
      <p class="mt-14 max-w-3xl text-charcoal/80">
        {home.coverageLine}
      </p>
    </div>
  </section>

  <CtaBand heading={home.ctaHeading} body={home.ctaBody} />
</BaseLayout>
