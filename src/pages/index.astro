---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatCounter from '../components/StatCounter.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { FIRM, links } from '../lib/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

/**
 * Hero headline — three options considered, per brief §5 ("write 2–3 options,
 * don't just use this verbatim"):
 *   A. "Integrated Corporate & Legal Support for Businesses in Sri Lanka"  (chosen)
 *   B. "One Partner for Every Stage of Doing Business in Sri Lanka"
 *   C. "Corporate, Legal and Compliance Support — Under One Roof"
 */
const headline = 'Integrated Corporate & Legal Support for Businesses in Sri Lanka';

const whyFortis = [
  {
    title: 'Integrated Business Support',
    body: 'Access corporate, legal, HR, accounting, tax and compliance services through one provider — reducing the need to coordinate with multiple firms.',
  },
  {
    title: 'Practical & Business-Focused Advice',
    body: "Practical solutions grounded in your business objectives, not purely theoretical or technical advice.",
  },
  {
    title: 'Personalised & Reliable Service',
    body: 'Close, responsive support tailored to the size, requirements and stage of your business.',
  },
];

const whoWeServe = [
  { group: 'SMEs & established local businesses', line: 'Day-to-day corporate, legal and compliance support that scales with you.' },
  { group: 'Startups & entrepreneurs', line: 'Getting the legal and corporate foundations right from day one.' },
  { group: 'Foreign investors & foreign-owned businesses', line: 'Structuring, registration and compliance support for entering the Sri Lankan market.' },
  { group: 'Corporates & larger businesses', line: 'Dependable corporate secretarial and legal support at scale.' },
  { group: 'Individuals & professionals', line: 'Notarial, statutory and legal documentation handled with care.' },
  { group: 'Listed companies & regulated-sector businesses', line: 'Governance and compliance support for regulatory obligations.' },
];
---

<BaseLayout
  title="Fortis Corporate Services — Corporate, Legal & Compliance Support in Sri Lanka"
  description="Fortis Corporate Services provides corporate, legal, HR, accounting and compliance support to businesses and investors in Sri Lanka — under one roof."
  path="/"
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy">
    <div class="absolute inset-0 opacity-[0.07]" aria-hidden="true">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="48" height="48" patternUnits="userSpaceOnUse">
            <path d="M 48 0 L 0 0 0 48" fill="none" stroke="#F7F7F8" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
      </svg>
    </div>
    <div class="relative container-px mx-auto max-w-content py-24 sm:py-32 lg:py-40">
      <p class="eyebrow">Colombo, Sri Lanka</p>
      <h1 class="mt-4 max-w-3xl text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.1]">
        {headline}
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-navy-100">
        Fortis Corporate Services provides corporate, legal, HR, accounting and compliance support to businesses and investors in Sri Lanka — under one roof.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <a href="/contact" class="btn-primary">Submit an Enquiry</a>
        <a href={links.tel} class="btn-secondary-inverted">Call {FIRM.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <!-- Stats band -->
  <section class="bg-navy-700">
    <div class="container-px mx-auto max-w-content py-14 grid grid-cols-1 sm:grid-cols-3 gap-10">
      <StatCounter value={30} suffix="+" label="Years combined professional experience" />
      <StatCounter value={20} suffix="+" label="Companies incorporated" />
      <StatCounter value={6} label="Integrated service areas" />
    </div>
  </section>

  <!-- Service teaser -->
  <section class="section bg-offwhite">
    <div class="container-px mx-auto max-w-content">
      <p class="eyebrow">What we do</p>
      <h2 class="mt-3 text-3xl sm:text-4xl max-w-2xl">Six integrated service areas, one point of contact</h2>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <a
            href={`/services#${service.data.anchor}`}
            class="group block rounded-sm border border-navy-100 bg-white p-7 hover:border-bronze hover:shadow-md transition-all duration-150"
          >
            <h3 class="text-xl leading-snug group-hover:text-bronze-600">{service.data.title}</h3>
            <p class="mt-3 text-sm text-charcoal/80">{service.data.summary}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-bronze">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Fortis -->
  <section class="section bg-white">
    <div class="container-px mx-auto max-w-content">
      <p class="eyebrow">Why Fortis</p>
      <h2 class="mt-3 text-3xl sm:text-4xl max-w-2xl">A different kind of corporate services partner</h2>
      <div class="mt-12 grid md:grid-cols-3 gap-10">
        {whyFortis.map((item) => (
          <div>
            <div class="h-1 w-10 bg-bronze mb-5"></div>
            <h3 class="text-xl">{item.title}</h3>
            <p class="mt-3 text-sm text-charcoal/80">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who we serve -->
  <section class="section bg-offwhite">
    <div class="container-px mx-auto max-w-content">
      <p class="eyebrow">Who we serve</p>
      <h2 class="mt-3 text-3xl sm:text-4xl max-w-2xl">Built for businesses at every stage</h2>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-8">
        {whoWeServe.map((item) => (
          <div class="border-l-2 border-bronze pl-5">
            <h3 class="text-base font-semibold text-navy">{item.group}</h3>
            <p class="mt-1 text-sm text-charcoal/80">{item.line}</p>
          </div>
        ))}
      </div>
      <p class="mt-14 max-w-3xl text-charcoal/80">
        We serve clients across Sri Lanka, with a strong presence in Colombo and the Western Province, and support foreign investors and overseas businesses establishing, operating or investing in Sri Lanka. Many of our services can be delivered remotely.
      </p>
    </div>
  </section>

  <CtaBand
    heading="Ready to discuss your requirements?"
    body="Tell us what you need and we'll get back to you shortly."
  />
</BaseLayout>
