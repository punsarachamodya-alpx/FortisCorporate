---
import { primaryNav, serviceCategorySlugs, getFirmSettings } from '../lib/site';
import BrandLogo from './BrandLogo.astro';

const { FIRM } = await getFirmSettings();
const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-offwhite/95 backdrop-blur border-b border-navy-100">
  <nav class="container-px mx-auto max-w-content flex items-center justify-between h-20">
    <a href="/" class="shrink-0" aria-label={`${FIRM.tradingName} — Home`}>
      <BrandLogo variant="navy" />
    </a>

    <button
      id="nav-toggle"
      class="md:hidden inline-flex flex-col justify-center gap-1.5 w-10 h-10"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Toggle navigation menu"
    >
      <span class="block h-0.5 w-6 bg-navy"></span>
      <span class="block h-0.5 w-6 bg-navy"></span>
      <span class="block h-0.5 w-6 bg-navy"></span>
    </button>

    <ul class="hidden md:flex items-center gap-8 font-body text-sm font-medium">
      {primaryNav.map((item) =>
        item.label === 'Services' ? (
          <li class="relative group">
            <a
              href={item.href}
              class:list={[
                'inline-flex items-center gap-1 hover:text-bronze',
                isActive(item.href) ? 'text-bronze' : 'text-navy',
              ]}
            >
              {item.label}
              <svg class="h-3 w-3 transition-transform duration-200 group-hover:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 7.5L10 12.5L15 7.5" />
              </svg>
            </a>

            <div class="absolute left-1/2 top-full w-max -translate-x-1/2 pt-3 opacity-0 invisible -translate-y-1 transition-all duration-200 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0">
              <div class="rounded-sm border border-navy-100 bg-white/80 backdrop-blur-md shadow-lg p-5">
                <ul class="grid grid-cols-2 gap-x-8 gap-y-3 whitespace-nowrap">
                  {serviceCategorySlugs.map((s) => (
                    <li>
                      <a href={`/services#${s.anchor}`} class="text-navy hover:text-bronze">{s.label}</a>
                    </li>
                  ))}
                </ul>
                <a href="/services" class="mt-4 block border-t border-navy-100 pt-3 text-sm font-semibold text-bronze hover:text-bronze-600">
                  View all services →
                </a>
              </div>
            </div>
          </li>
        ) : (
          <li>
            <a
              href={item.href}
              class:list={[
                'hover:text-bronze',
                isActive(item.href) ? 'text-bronze' : 'text-navy',
              ]}
            >
              {item.label}
            </a>
          </li>
        )
      )}
    </ul>

    <a href="/contact" class="hidden md:inline-flex btn-primary">Submit an Enquiry</a>
  </nav>

  <ul id="mobile-nav" class="md:hidden hidden flex-col gap-1 px-6 pb-6 font-body text-sm font-medium bg-offwhite border-t border-navy-100">
    {primaryNav.map((item) => (
      <li>
        <a
          href={item.href}
          class:list={[
            'block py-3 hover:text-bronze',
            isActive(item.href) ? 'text-bronze' : 'text-navy',
          ]}
        >
          {item.label}
        </a>
      </li>
    ))}
    <li class="pt-2">
      <a href="/contact" class="btn-primary w-full">Submit an Enquiry</a>
    </li>
  </ul>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
  });
</script>
