---
/**
 * BrandLogo.astro — the official Fortis Corporate Services mark, paired with
 * a stacked "FORTIS / CORPORATE SERVICES" text lockup matching the brand's
 * original wordmark styling (the delivered brand assets are mark-only, no
 * wordmark file, so the text is set in Montserrat rather than vector-traced).
 *
 * `variant="navy"` (default) for light backgrounds (header), `variant="white"`
 * for the navy footer/hero.
 */
import navyMark from '../assets/brand/fortis-logo-mark-navy.svg?raw';
import whiteMark from '../assets/brand/fortis-logo-mark-white.svg?raw';

interface Props {
  variant?: 'navy' | 'white';
  class?: string;
}

const { variant = 'navy', class: className } = Astro.props;
const markSvg = variant === 'white' ? whiteMark : navyMark;
const textColorClass = variant === 'white' ? 'text-white' : 'text-navy';
---

<span class:list={['inline-flex items-center gap-2.5 [&>svg]:h-10 [&>svg]:w-auto sm:[&>svg]:h-11', className]}>
  <Fragment set:html={markSvg} />
  <span class:list={['font-brand leading-none', textColorClass]}>
    <span class="block text-xl sm:text-2xl font-black tracking-tight uppercase">Fortis</span>
    <span class="block text-[10px] sm:text-xs font-bold tracking-[0.2em] uppercase mt-0.5">Corporate Services</span>
  </span>
</span>
