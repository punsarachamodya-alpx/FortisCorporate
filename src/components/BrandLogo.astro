---
/**
 * BrandLogo.astro — the official Fortis Corporate Services mark, paired with
 * the true vector "FORTIS / CORPORATE SERVICES" wordmark extracted from the
 * brand's original lockup artwork (letterforms as authored, not a font
 * substitute).
 *
 * `variant="navy"` (default) for light backgrounds (header), `variant="white"`
 * for the navy footer/hero.
 */
import navyMark from '../assets/brand/fortis-logo-mark-navy.svg?raw';
import whiteMark from '../assets/brand/fortis-logo-mark-white.svg?raw';
import navyWordmark from '../assets/brand/fortis-wordmark-navy.svg?raw';
import whiteWordmark from '../assets/brand/fortis-wordmark-white.svg?raw';

interface Props {
  variant?: 'navy' | 'white';
  class?: string;
}

const { variant = 'navy', class: className } = Astro.props;
const markSvg = variant === 'white' ? whiteMark : navyMark;
const wordmarkSvg = variant === 'white' ? whiteWordmark : navyWordmark;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <span class="inline-flex [&>svg]:h-9 [&>svg]:w-auto sm:[&>svg]:h-11">
    <Fragment set:html={markSvg} />
  </span>
  <span class="inline-flex [&>svg]:h-8 [&>svg]:w-auto sm:[&>svg]:h-10">
    <Fragment set:html={wordmarkSvg} />
  </span>
</span>
