---
import { links } from '../lib/site';
---

<a
  href={links.whatsapp}
  target="_blank"
  rel="noopener"
  aria-label="Message us on WhatsApp"
  class="whatsapp-fab fixed z-40 bottom-5 right-5 sm:bottom-6 sm:right-6 flex items-center justify-center w-14 h-14 rounded-full bg-[#25D366] text-white shadow-lg shadow-navy-900/20 hover:scale-105 active:scale-95 transition-transform duration-200"
>
  <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor" aria-hidden="true">
    <path d="M16.004 3C9.377 3 4 8.373 4 15c0 2.34.664 4.523 1.814 6.377L4 29l7.822-1.767A11.94 11.94 0 0 0 16.004 27C22.63 27 28 21.627 28 15S22.63 3 16.004 3Zm0 21.7c-1.94 0-3.75-.55-5.29-1.502l-.38-.226-4.64 1.048 1.07-4.52-.25-.394A9.65 9.65 0 0 1 5.3 15c0-5.906 4.8-10.7 10.704-10.7 5.905 0 10.7 4.794 10.7 10.7 0 5.906-4.795 10.7-10.7 10.7Zm5.86-8.01c-.32-.16-1.9-.938-2.194-1.045-.294-.107-.508-.16-.722.16-.213.32-.827 1.045-1.014 1.26-.187.213-.374.24-.694.08-.32-.16-1.352-.498-2.575-1.588-.952-.85-1.595-1.9-1.782-2.22-.187-.32-.02-.494.14-.653.144-.144.32-.374.48-.56.16-.187.213-.32.32-.534.107-.213.053-.4-.027-.56-.08-.16-.722-1.74-.99-2.383-.26-.626-.526-.54-.722-.55l-.615-.01c-.213 0-.56.08-.854.4-.293.32-1.12 1.094-1.12 2.668 0 1.574 1.147 3.094 1.307 3.307.16.213 2.257 3.446 5.47 4.833.764.33 1.36.527 1.825.674.767.244 1.465.21 2.017.127.615-.092 1.9-.777 2.167-1.527.267-.75.267-1.394.187-1.528-.08-.133-.294-.213-.614-.373Z"/>
  </svg>
</a>

<style>
  .whatsapp-fab {
    animation: whatsapp-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: 0.6s;
    opacity: 0;
  }

  @keyframes whatsapp-pop {
    from {
      opacity: 0;
      transform: scale(0.4) translateY(12px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab {
      animation: none;
      opacity: 1;
    }
  }
</style>
