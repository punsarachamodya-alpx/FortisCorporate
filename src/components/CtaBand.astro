---
import { FIRM, links } from '../lib/site';

interface Props {
  heading: string;
  body?: string;
}
const { heading, body } = Astro.props;
---

<section class="bg-navy">
  <div class="container-px mx-auto max-w-content py-16 sm:py-20 text-center">
    <h2 class="text-2xl sm:text-3xl text-white max-w-2xl mx-auto">{heading}</h2>
    {body && <p class="mt-4 text-navy-100 max-w-xl mx-auto">{body}</p>}
    <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/contact" class="btn-primary">Submit an Enquiry</a>
      <a href={links.tel} class="btn-secondary-inverted">Call {FIRM.phoneDisplay}</a>
    </div>
  </div>
</section>
