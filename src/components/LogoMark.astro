---
/**
 * LogoMark.astro — official Fortis Corporate Services logo mark, vectorised
 * from "Logo Design.pdf" (concept & design by Akila M.). Uses fill="currentColor"
 * so colour is controlled by the CSS `color` of the wrapping element (e.g. a
 * Tailwind `text-navy` / `text-white` class), letting one file serve both the
 * light-background header and the dark-background footer.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
